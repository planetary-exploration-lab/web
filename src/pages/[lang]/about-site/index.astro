---
import Base from '../../../layouts/Base.astro';
import { localePaths, t, type Locale } from '../../../i18n';
import { Content } from '../../../data/about-site.md';

export const getStaticPaths = localePaths;
const lang = Astro.params.lang as Locale;
const ui: Locale = 'en';
---
<Base lang={lang} contentLang={ui} title={t(ui, 'about.title')} description={t(ui, 'about.description')}>
  <h1>{t(ui, 'about.title')}</h1>
  <div class="prose"><Content /></div>
</Base>
