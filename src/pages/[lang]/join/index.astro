---
import Base from '../../../layouts/Base.astro';
import { localePaths, t, type Locale } from '../../../i18n';
import { Content } from '../../../data/join.md';

export const getStaticPaths = localePaths;
const lang = Astro.params.lang as Locale;
const ui: Locale = 'en';
---
<Base lang={lang} contentLang={ui} title={t(ui, 'join.title')} description={t(ui, 'join.description')} section="contact">
  <h1>{t(ui, 'join.title')}</h1>
  <div class="prose"><Content /></div>
</Base>
