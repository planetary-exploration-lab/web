---
import Base from '../../../layouts/Base.astro';
import PubAuthors from '../../../components/PubAuthors.astro';
import { LOCALES, t, type Locale } from '../../../i18n';
import { loadData, type PubWithExtras } from '../../../lib/data';
import PubIds from '../../../components/PubIds.astro';
import { citeDate, pubGroup, pubLinks, venueDetail } from '../../../lib/pubs';
import { localeUrl } from '../../../lib/url';

export async function getStaticPaths() {
  const { publications } = await loadData();
  return LOCALES.flatMap((lang) => publications.map((pub) => ({ params: { lang, key: pub.id }, props: { pub } })));
}
interface Props { pub: PubWithExtras }
const { pub } = Astro.props;
const lang = Astro.params.lang as Locale;
const ui: Locale = 'en';
const data = await loadData();
const d = pub.data;
const detail = venueDetail(pub);
const links = pubLinks(pub);
const projects = data.projectsFor(pub.extras?.projects ?? []);
---
<Base lang={lang} contentLang={ui} title={d.title} description={d.venue ? `${d.venue}, ${d.year}` : String(d.year)} section="publications">
  <article class="wide">
    <p><a href={localeUrl(lang, 'publications/')}>{t(ui, 'pubs.back')}</a></p>
    <p class="eyebrow">{t(ui, `pubs.one.${pubGroup(d.type)}`)} · {d.year}</p>
    <h1>{d.title}</h1>
    <p><PubAuthors pub={pub} /></p>
    {d.venue && (
      <p><em>{d.venue}</em>{detail && ` ${detail}`}{d.publisher && `. ${d.publisher}`}. {citeDate(pub)}.</p>
    )}
    <p><PubIds pub={pub} /></p>
    {links.length > 0 && <ul>{links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>}
    {pub.extras?.summary && (<><h2>{t(ui, 'pubs.summary')}</h2><p>{pub.extras.summary}</p></>)}
    {projects.length > 0 && (
      <><h2>{t(ui, 'nav.projects')}</h2>
      <ul>{projects.map((p) => <li><a href={localeUrl(lang, `projects/${p.id}/`)}>{p.data.title}</a></li>)}</ul></>
    )}
  </article>
</Base>
