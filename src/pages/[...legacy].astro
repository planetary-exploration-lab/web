---
// Static redirect pages for old Squarespace addresses: meta refresh, rel=canonical and a visible link.
import { loadRedirects } from '../lib/redirects';
import { url } from '../lib/url';

export async function getStaticPaths() {
  return (await loadRedirects()).map((r) => ({ params: { legacy: decodeURIComponent(r.from.slice(1)) }, props: { to: r.to } }));
}
const to = url(Astro.props.to as string);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={new URL(to, Astro.site).href} />
    <title>Page moved | Planetary eXploration Lab</title>
  </head>
  <body>
    <main>
      <h1>This page has moved</h1>
      <p><a href={to}>Continue to the new page</a> ({new URL(to, Astro.site).pathname}).</p>
    </main>
  </body>
</html>
