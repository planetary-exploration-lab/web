---
import '../styles/global.css';
import LangSwitcher from '../components/LangSwitcher.astro';
import T from '../components/T.astro';
import { LOCALES, t, type Locale } from '../i18n';
import { localeUrl, switchLocale } from '../lib/url';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  /** Language the main content is written in. When it differs from `lang`, a fallback notice is shown. */
  contentLang?: Locale;
  /** Nav item to mark as current. */
  section?: 'home' | 'projects' | 'people' | 'publications' | 'gallery' | 'news' | 'contact';
  /** Pages with no stable URL (404) skip canonical and hreflang links. */
  noAlternates?: boolean;
}
const { lang, title, description, contentLang = 'en', section, noAlternates = false } = Astro.props;
const fallback = contentLang !== lang;
const siteName = t('en', 'site.name');
const pageTitle = section === 'home' ? siteName : `${title} | ${siteName}`;
const abs = (path: string) => new URL(path, Astro.site).href;

// Static CSP. Iframes are allowed only from youtube-nocookie, and the click-to-load
// video component creates them only after the visitor clicks.
const csp = [
  "default-src 'self'",
  "img-src 'self' data:",
  "style-src 'self'",
  "script-src 'self'",
  "font-src 'self'",
  "connect-src 'self'",
  'frame-src https://www.youtube-nocookie.com',
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');

const nav = [
  ['home', '', 'nav.home'],
  ['people', 'people/', 'nav.people'],
  ['projects', 'projects/', 'nav.projects'],
  ['publications', 'publications/', 'nav.publications'],
  ['gallery', 'gallery/', 'nav.gallery'],
  ['news', 'news/', 'nav.news'],
  ['contact', 'contact/', 'nav.contact'],
] as const;
const indexing = process.env.INDEXING === 'true';
// PXL badge by Snigdha Nellutla (made for the lab). Files built by scripts/make_brand_assets.mjs; to switch to the
// white alternative (option C), use pxl-logo-white.svg here and set SITE_VARIANT in that script.
const base = import.meta.env.BASE_URL;
const logo = `${base}logo/pxl-logo-gold.svg`;
const ogImage = abs(`${base}og.png`);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {!indexing && <meta name="robots" content="noindex, nofollow" />}
    {!noAlternates && (
      <>
        <link rel="canonical" href={abs(Astro.url.pathname)} />
        {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={abs(switchLocale(Astro.url.pathname, l))} />)}
        <link rel="alternate" hreflang="x-default" href={abs(switchLocale(Astro.url.pathname, 'en'))} />
      </>
    )}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {!noAlternates && <meta property="og:url" content={abs(Astro.url.pathname)} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PXL badge with the text Planetary eXploration Lab, Georgia Tech, Aerospace Engineering." />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main"><T lang={lang} k="skip" /></a>
    <header class="site-header">
      <div class="bar wrap">
        <a class="brand" href={localeUrl(lang)} lang="en"><img src={logo} alt="" width="44" height="44" />{siteName}</a>
        <nav class="site-nav" aria-label={t(lang, 'nav.label')}>
          <ul>
            {nav.map(([key, path, label]) => (
              <li><a href={localeUrl(lang, path)} aria-current={section === key ? 'page' : undefined}><T lang={lang} k={label} /></a></li>
            ))}
          </ul>
        </nav>
        <LangSwitcher lang={lang} />
      </div>
    </header>
    <div class="wrap">
      <main id="main" tabindex="-1" lang={fallback ? contentLang : undefined}>
        {fallback && (
          <p class="notice" role="note" lang={lang}><T lang={lang} k="fallback.notice" /></p>
        )}
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <div class="wrap" lang="en">
        <p>{siteName}. {t('en', 'footer.affiliation')}.</p>
        <p>{t('en', 'footer.ai')} <a href={localeUrl(lang, 'about-site/')}>{t('en', 'footer.about')}</a> · <a href={localeUrl(lang, 'about-site/') + '#accessibility'}>{t('en', 'footer.accessibility')}</a></p>
        {!indexing && <p>{t('en', 'footer.preview')}</p>}
      </div>
    </footer>
  </body>
</html>
