---
import { Image } from 'astro:assets';
import { t, type Locale } from '../i18n';
import { localeUrl } from '../lib/url';
import type { Project } from '../lib/data';
interface Props { lang: Locale; ui: Locale; projects: Project[]; headingLevel?: 'h2' | 'h3' }
const { lang, ui, projects, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---
<ul class="cards">
  {projects.map((p) => (
    <li class="card">
      <Image src={p.data.image.src} alt="" widths={[400, 800]} sizes="(max-width: 40rem) 100vw, 22rem" />
      <div class="body">
        <p class="eyebrow">{t(ui, `projects.status.${p.data.status}`)}</p>
        <H class="h3"><a href={localeUrl(lang, `projects/${p.id}/`)}>{p.data.title}</a></H>
        <p>{p.data.summary}</p>
      </div>
    </li>
  ))}
</ul>
